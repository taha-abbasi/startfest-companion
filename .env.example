# ── StartFest Companion — environment ───────────────────────────────────────
# Copy to .env.local for local dev. Never commit real values.

# MongoDB connection.
MONGODB_URI="mongodb+srv://USER:PASS@host/?retryWrites=true&w=majority&authSource=admin"
# Database the connecting user is authorized for.
MONGODB_DB="startfest"
# All app collections are namespaced under this prefix (e.g. startfest_attendees,
# startfest_signups), so they stay isolated from anything else in the database.
MONGODB_COLLECTION_PREFIX="startfest_"

# Resend (transactional email). Sending domain must be verified in Resend.
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="StartFest <startfest@tahaabbasi.com>"
EMAIL_REPLY_TO="taha.abbasi@abbasiindustries.com"

# Secret used to sign identity cookies + manage/unsubscribe tokens (HMAC).
# Generate: openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string"

# Protects the reminder cron endpoint. Generate: openssl rand -hex 16
CRON_SECRET="change-me"

# Public base URL of the deployed app (used in emails / calendar links).
NEXT_PUBLIC_BASE_URL="https://startfest.example.com"

# ── Optional: SMS reminders (pluggable). Leave blank to disable SMS. ──────────
# When all three are present, opted-in attendees with a phone number get texts.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
